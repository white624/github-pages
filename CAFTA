<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para Ti, Mi Amor ❤️</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #ffccd5;
            margin: 0;
            overflow: hidden;
        }

        /* Animación de corazones flotando */
        @keyframes corazones {
            0% { transform: translateY(100vh) scale(1); opacity: 1; }
            100% { transform: translateY(-10vh) scale(0.5); opacity: 0; }
        }

        .corazon {
            position: absolute;
            color: red;
            font-size: 30px;
            animation: corazones 5s linear infinite;
        }

        .carta {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            max-width: 400px;
            margin: auto;
            position: relative;
            top: 100px;
            opacity: 0;
            transform: scale(0.8);
            transition: opacity 1s, transform 0.5s;
        }

        h1 {
            color: #ff4d4d;
        }

        .mensaje {
            font-size: 18px;
            margin: 20px 0;
        }

        button {
            background: #ff4d4d;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            background: #cc0000;
        }

        .oculto {
            display: none;
        }

        /* Efecto de aparición suave */
        .mostrar {
            opacity: 1;
            transform: scale(1);
        }
    </style>
</head>
<body>

    <!-- Corazones flotando -->
    <script>
        function crearCorazon() {
            let corazon = document.createElement("div");
            corazon.innerHTML = "❤️";
            corazon.classList.add("corazon");
            corazon.style.left = Math.random() * 100 + "vw";
            corazon.style.animationDuration = (Math.random() * 3 + 2) + "s"; 
            document.body.appendChild(corazon);
            setTimeout(() => corazon.remove(), 5000);
        }
        setInterval(crearCorazon, 500);
    </script>

    <div class="carta" id="carta">
        <h1>Para Ti, Mi Amor ❤️</h1>
        <p class="mensaje">Tengo algo especial para ti...</p>
        <button onclick="mostrarCarta()">Haz clic aquí</button>
        
        <div id="contenido" class="oculto">
            <p>Mi amor, cada día a tu lado es un regalo. Eres lo mejor que me ha pasado y quiero que siempre recuerdes lo mucho que te amo. ❤️</p>
            <img src="https://i.pinimg.com/originals/bd/bd/3d/bdbd3d1d682a42ea5ee6a3d4e942afcb.gif" width="100%">
        </div>
    </div>

    <script>
        // Efecto de aparición para la carta
        window.onload = function() {
            document.getElementById("carta").classList.add("mostrar");
        }

        function mostrarCarta() {
            document.getElementById("contenido").classList.remove("oculto");
        }
    </script>

</body>
</html>
